{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ginsenoside-evidence-atlas",
  "main": "./dist/server/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ginsenoside-evidence-atlas-db",
      "database_id": "5d193baf-a03a-45fb-95bb-9c4130ce81e4",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
